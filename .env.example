# Copy this file to .env.local and paste your real key there.
# .env.local is ignored by git, so it never reaches GitHub.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional: which Gemini model to use (defaults to gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
# Optional: backup model used when the main one is busy (defaults to gemini-flash-lite-latest)
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Razorpay Test Mode keys, for sending payment links by SMS.
# Dashboard (Test Mode) → Account & Settings → API Keys → Generate Key
RAZORPAY_KEY_ID=rzp_test_paste-your-key-id
RAZORPAY_KEY_SECRET=paste-your-key-secret

# Optional. Leave this out to text the number on each member's card.
# Add it only if you want every SMS to go to one number instead.
# RAZORPAY_SMS_TO=your-10-digit-mobile
